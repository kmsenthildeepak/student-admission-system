<%@ page contentType="text/html;charset=UTF-8" %><%@ page import="java.util.*" %><!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Student Profiles</title><style>body{font:15px Arial;background:#eef3f8;margin:20px;color:#172033}.wrap{max-width:1100px;margin:auto}.card{background:white;padding:18px;margin:14px 0;border-radius:10px}table{width:100%;border-collapse:collapse}td,th{border:1px solid #d5dce5;padding:9px;text-align:left}th{background:#eaf1fb}a{color:#174ea6}</style></head><body><main class="wrap"><h1>Student Profiles</h1><p>Authenticated student portal</p><% List<Map<String,Object>> students=(List<Map<String,Object>>)request.getAttribute("students"); if(students==null||students.isEmpty()){ %><section class="card">No student records found. Add records using the PHP admin panel.</section><% } else { %><section class="card"><div style="overflow-x:auto"><table><tr><th>Name</th><th>Roll number</th><th>Email</th><th>Course</th><th>Files</th></tr><% for(Map<String,Object> s:students){ %><tr><td><%= esc(s.get("name")) %></td><td><%= esc(s.get("roll")) %></td><td><%= esc(s.get("email")) %></td><td><%= esc(s.get("course")) %></td><td><% if(s.get("fileId")!=null){ int fileId=((Number)s.get("fileId")).intValue(); String type=String.valueOf(s.get("fileType")); if(type.startsWith("image/")){ %><img alt="Student file" width="90" src="${pageContext.request.contextPath}/file?id=<%=fileId%>"><br><% } %><a href="${pageContext.request.contextPath}/file?id=<%=fileId%>"><%= esc(s.get("fileName")) %></a><% } else { %>No file<% } %></td></tr><% } %></table></div></section><% } %></main></body></html><%! private String esc(Object value){ if(value==null)return ""; return String.valueOf(value).replace("&","&amp;").replace("<","&lt;").replace(">","&gt;").replace(""","&quot;").replace("'","&#x27;"); } %>
